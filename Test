let state = JSON.parse(
  localStorage.getItem("fp_state") ||
    '{"done":[],"scores":[],"words":[],"days":[],"last":null}'
);
function save() {
  localStorage.setItem("fp_state", JSON.stringify(state));
  updateStats();
}
function showView(id) {
  document
    .querySelectorAll(".view")
    .forEach((x) => x.classList.remove("active"));
  document.getElementById(id).classList.add("active");
  document
    .querySelectorAll(".navbtn")
    .forEach((x) => x.classList.toggle("active", x.dataset.view === id));
  if (id === "progress") renderProgress();
  if (id === "vocab") renderWords();
  window.scrollTo(0, 0);
}
document
  .querySelectorAll(".navbtn")
  .forEach((b) => (b.onclick = () => showView(b.dataset.view)));
function levelCards(target) {
  document.getElementById(target).innerHTML = ["A1", "A2", "B1", "B2"]
    .map(
      (l, i) =>
        `<button class="level" onclick="selectLevel('${l}')"><strong>${l}</strong><b>${ ["Débutant", "Élémentaire", "Intermédiaire", "Avancé"][i] }</b><small>${ [ "Làm quen tiếng Pháp", "Giao tiếp quen thuộc", "Giao tiếp độc lập", "Sử dụng thành thạo", ][i] }</small><div class="progress"><i style="width:${levelProgress( l )}%"></i></div><small>${levelProgress(l)}% hoàn thành</small></button>`
    )
    .join("");
}
function levelProgress(l) {
  let ids = units[l].map((_, i) => l + "-" + i);
  return Math.round(
    (ids.filter((x) => state.done.includes(x)).length / ids.length) * 100
  );
}
function selectLevel(l) {
  showView("courses");
  document.getElementById("courseDetail").innerHTML = `<h2>${l} – ${levelName( l )}</h2><div class="lessonlist">${units[l] .map( (u, i) => `<div class="lessoncard"><div><span class="tag">${l} · ${ state.done.includes(l + "-" + i) ? "ĐÃ HOÀN THÀNH" : "CHƯA HỌC" }</span><h3>${u[0]}</h3><p>${u[1]} · ${ u[2] }</p></div><button class="btn" onclick="openLesson('${l}',${i})">Vào bài học →</button></div>` ) .join("")}</div>`;
}
function levelName(l) {
  return {
    A1: "Débutant",
    A2: "Élémentaire",
    B1: "Intermédiaire",
    B2: "Avancé",
  }[l];
}
function openLesson(l, i) {
  let u = units[l][i];
  showView("lesson");
  document.getElementById(
    "lessonContent"
  ).innerHTML = `<span class="tag">${l} · ${u[0]}</span><h2>${ u[1] }</h2><div class="panel"><h3>🎯 Objectif – Mục tiêu</h3><p>${ u[2] }</p><h3>📖 Exemple – Ví dụ</h3><p style="font-size:19px;color:#173b72;font-weight:650">${ u[3] }</p><button class="btn secondary" onclick="speak(${JSON.stringify( u[3] )})">🔊 Nghe phát âm</button><h3 style="margin-top:20px">🗂️ Vocabulaire – Từ vựng</h3><p>${ u[4] }</p><h3>✍️ À vous ! – Thực hành</h3><p>Hãy đọc lại câu ví dụ, chú ý cấu trúc ngữ pháp và thử tự đặt một câu tương tự.</p><button class="btn" onclick="lessonQuiz('${l}',${i})">Làm bài kiểm tra cuối bài</button></div>`;
}
function lessonQuiz(l, i) {
  window.lessonContext = { l, i };
  document.getElementById("practiceLevel").value = l;
  showView("practice");
  startQuiz();
}
let current = [],
  answers = {},
  qIndex = 0;
function startQuiz() {
  let l = document.getElementById("practiceLevel").value;
  current = questions[l].map((q, i) => ({ ...{ q }, id: i }));
  answers = {};
  qIndex = 0;
  renderQuestion(l);
}
function renderQuestion(l) {
  let area = document.getElementById("quizArea");
  if (qIndex >= current.length) {
    let score = current.filter((q, i) => answers[i] === q.q[3]).length;
    let pct = Math.round((score / current.length) * 100);
    state.scores.push({
      level: l,
      score,
      pct,
      date: new Date().toLocaleDateString("vi-VN"),
    });
    if (window.lessonContext && window.lessonContext.l === l) {
      let id = l + "-" + window.lessonContext.i;
      if (!state.done.includes(id)) state.done.push(id);
      window.lessonContext = null;
    }
    state.days.push(new Date().toDateString());
    save();
    area.innerHTML = `<div class="panel"><h2>Résultat – Kết quả</h2><h1 style="color:var(--blue);font-size:42px">${score}/${ current.length }</h1><p>Bạn đạt ${pct}% số câu đúng.</p><p>${ pct >= 80 ? "Excellent ! Rất tốt!" : pct >= 60 ? "Bien joué ! Hãy tiếp tục luyện tập." : "Cố gắng ôn lại kiến thức và thử lại nhé!" }</p><button class="btn" onclick="startQuiz()">Làm lại</button></div>`;
    return;
  }
  let q = current[qIndex].q;
  area.innerHTML = `<div class="between"><span class="tag">${l} · Question ${ qIndex + 1 }/${current.length}</span><span class="muted">${Math.round( (qIndex / current.length) * 100 )}% </span></div><div class="question"><h3>${q[0]}</h3><p class="muted">${ q[1] }</p>${q[2] .map( (o, i) => `<button class="option ${ answers[qIndex] === i ? "selected" : "" }" onclick="choose(${i})">${String.fromCharCode(65 + i)}. ${o}</button>` ) .join( "" )}</div><div class="between"><button class="btn secondary" onclick="qIndex=Math.max(0,qIndex-1);renderQuestion('${l}')" ${ qIndex === 0 ? "disabled" : "" }>← Trước</button><button class="btn" onclick="nextQuestion('${l}')" ${ answers[qIndex] === undefined ? "disabled" : "" }>${ qIndex === current.length - 1 ? "Nộp bài" : "Tiếp theo →" }</button></div>`;
}
function choose(i) {
  answers[qIndex] = i;
  renderQuestion(document.getElementById("practiceLevel").value);
}
function nextQuestion(l) {
  qIndex++;
  renderQuestion(l);
}
function speak(t) {
  if (!("speechSynthesis" in window)) {
    alert("Trình duyệt này chưa hỗ trợ đọc văn bản.");
    return;
  }
  let u = new SpeechSynthesisUtterance(t);
  u.lang = "fr-FR";
  u.rate = 0.88;
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}
function renderWords() {
  let q = (document.getElementById("wordSearch")?.value || "").toLowerCase();
  let arr = vocab.filter((w) => w.join(" ").toLowerCase().includes(q));
  document.getElementById("wordList").innerHTML =
    arr
      .map(
        (w, i) =>
          `<div class="word"><div><strong>${ w[0] }</strong><br><span class="muted">${ w[1] }</span></div><div class="row"><button class="btn secondary" onclick="speak(${JSON.stringify( w[0] )})">🔊</button><button class="btn ghost" onclick="markWord(${JSON.stringify( w[0] )})">${state.words.includes(w[0]) ? "✓" : "Ôn"}</button></div></div>`
      )
      .join("") || '<div class="empty">Không tìm thấy từ phù hợp.</div>';
}
function markWord(w) {
  if (!state.words.includes(w)) state.words.push(w);
  save();
  renderWords();
}
function updateStats() {
  document.getElementById("statDone").textContent = state.done.length;
  document.getElementById("statScore").textContent = state.scores.length
    ? Math.round(
        state.scores.reduce((a, b) => a + b.pct, 0) / state.scores.length
      ) + "%"
    : "—";
  document.getElementById("statWords").textContent = state.words.length;
  document.getElementById("statStreak").textContent = new Set(state.days).size;
  levelCards("homeLevels");
  levelCards("courseLevels");
}
