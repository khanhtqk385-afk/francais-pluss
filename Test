  document.getElementById(
    "progressContent"
  ).innerHTML = `<div class="stats"><div class="stat"><b>${ state.done.length }</b><span>Bài đã hoàn thành</span></div><div class="stat"><b>${ state.scores.length }</b><span>Lượt kiểm tra</span></div><div class="stat"><b>${ state.words.length }</b><span>Từ đã ôn</span></div><div class="stat"><b>${ state.scores.length ? Math.round( state.scores.reduce((a, b) => a + b.pct, 0) / state.scores.length ) : 0 }%</b><span>Điểm trung bình</span></div></div><div class="panel"><h3>Tiến độ theo cấp độ</h3>${[ "A1", "A2", "B1", "B2", ] .map( (l) => `<p><b>${l}</b> – ${levelProgress( l )}%</p><div class="progress"><i style="width:${levelProgress( l )}%"></i></div>` ) .join( "" )}</div><div class="panel" style="margin-top:13px"><h3>Lịch sử kiểm tra</h3>${ state.scores.length ? state.scores .slice() .reverse() .map( (s) => `<div class="word"><span>${s.level} · ${s.date}</span><b>${s.score} câu đúng (${s.pct}%)</b></div>` ) .join("") : "<p class='muted'>Chưa có kết quả. Hãy làm bài luyện tập đầu tiên!</p>" }</div><div style="margin-top:13px"><button class="btn ghost" onclick="if(confirm('Bạn có chắc muốn xóa toàn bộ tiến độ trên thiết bị này?')){state={done:[],scores:[],words:[],days:[],last:null};save();renderProgress()}">Xóa dữ liệu tiến độ</button></div>`;
}
